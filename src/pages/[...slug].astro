---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AboutPage from '../components/AboutPage.astro';
import ClientsPage from '../components/ClientsPage.astro';
import ServicesPage from '../components/ServicesPage.astro';
import JournalPage from '../components/JournalPage.astro';
import CollectionsPage from '../components/CollectionsPage.astro';
import ContactPage from '../components/ContactPage.astro';
import ProjectPage from '../components/ProjectPage.astro';
import { pages, services } from '../lib/site';
import wordpressRecords from '../data/wordpress-content.json';
import PostBody from '../components/PostBody.astro';
import BlogFaqs from '../components/BlogFaqs.astro';
import ArticleShare from '../components/ArticleShare.astro';
import ArticleHero from '../components/ArticleHero.astro';
import ArticleToc from '../components/ArticleToc.astro';
import AnimationRuntime from '../components/AnimationRuntime.astro';
import { getAllPosts } from '../lib/sanity/posts';
import type { SanityPost } from '../lib/sanity/types';

export const prerender = true;
export async function getStaticPaths() {
  const sanityPosts = await getAllPosts() as SanityPost[];
  const postCount = sanityPosts.length;
  const journalPages = Array.from({ length: Math.ceil(Math.max(0, postCount - 6) / 10) }, (_, index) => `/journal/page/${index + 2}/`);
  const paths = [...Object.keys(pages), ...journalPages, ...services.map(([, href]) => href), ...wordpressRecords.map((record) => record.path), ...sanityPosts.map((post) => `/${post.slug}/`)];
  return [...new Set(paths)].map((path) => ({ params: { slug: path.slice(1, -1) }, props: { sanityPosts } }));
}

const {sanityPosts = []} = Astro.props as {sanityPosts?: SanityPost[]};
const path = `/${(Astro.params.slug ?? '').split('/').filter(Boolean).join('/')}/`;
const journalPageMatch = path.match(/^\/journal\/page\/(\d+)\/$/);
const journalPageNumber = journalPageMatch ? Number(journalPageMatch[1]) : path === '/journal/' ? 1 : 0;
const blogPageNumber = journalPageNumber;
const page = pages[path] || (journalPageNumber ? pages['/journal/'] : undefined);
const record = wordpressRecords.find((item) => item.path === path);
const sanityPost = sanityPosts.find((item) => `/${item.slug}/` === path);
if (!page && !record && !sanityPost) return Astro.redirect('/404/');
const service = services.find(([, href]) => href === path);
const articles = [...sanityPosts].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
const relatedArticles = sanityPost
  ? articles.filter((article) => article._id !== sanityPost._id).sort((a, b) => {
      const aSharedCategories = a.categories?.filter((category) => sanityPost.categories?.some((current) => current._id === category._id)).length ?? 0;
      const bSharedCategories = b.categories?.filter((category) => sanityPost.categories?.some((current) => current._id === category._id)).length ?? 0;
      return bSharedCategories - aSharedCategories || b.publishedAt.localeCompare(a.publishedAt);
    }).slice(0, 3)
  : [];
const totalJournalPages = 1 + Math.ceil(Math.max(0, articles.length - 6) / 10);
const visibleArticles = journalPageNumber === 1 ? articles.slice(0, 6) : journalPageNumber > 1 ? articles.slice(6 + (journalPageNumber - 2) * 10, 6 + (journalPageNumber - 1) * 10) : [];
const projects = wordpressRecords.filter((item) => item.type === 'portfolio');
const heading = sanityPost?.title || record?.title || service?.[0] || (journalPageNumber > 1 ? `${page!.heading} — Page ${journalPageNumber}` : page!.heading);
const description = sanityPost?.seo?.description || sanityPost?.excerpt || record?.description || service?.[2] || page!.intro;
const eyebrow = service ? 'Services' : sanityPost ? 'Journal' : record?.type === 'portfolio' ? 'Selected project' : path === '/about/' ? 'Orange Offices' : record ? 'Orange Offices' : page!.eyebrow;
const title = sanityPost?.seo?.title || (sanityPost ? `${sanityPost.title} | Orange Offices` : record?.seoTitle || (service ? `${service[0]} | Orange Offices` : journalPageNumber > 1 ? `Journal — Page ${journalPageNumber} | Orange Offices` : page!.title));
const clientLogos = path === '/clients/' && record?.contentHtml ? [...record.contentHtml.matchAll(/<img[^>]+src="([^"]+)"[^>]*>/g)].map((match) => match[1]).slice(5) : [];
const headquartersAddress = 'AIHP Tower, 249 G, Udyog Vihar Phase 4, Gurgaon 122015';
const contentHtml = record?.contentHtml
  ?.replaceAll('https://test123.aihp.in/wp-content/uploads/2026/07/Hybrid_Office_Workspace_Sizing_Formula.jpg', '/wp-content/uploads/2026/07/Hybrid_Office_Workspace_Sizing_Formula.jpg')
  ?.replaceAll('Plot No: 448 - 451, Udyog Vihar Phase V Rd, Gurugram, Haryana 122016', headquartersAddress)
  .replaceAll('AIHP Milestone<br />Plot No: 448 - 451, Rao Gajraj Singh Marg, Phase V,<br />Udyog Vihar, Sector 19, Gurugram, Haryana 122016', headquartersAddress);
const formattedContentHtml = contentHtml?.replace(/^(\s*<b>TL;DR[\s\S]*?)(?=<p>)/i, '<div class="article-summary">$1</div>');
const faqHeadingPattern = /<h2[^>]*>\s*(?:<[^>]+>\s*)*FAQs?[^<]*(?:<\/[^>]+>\s*)*<\/h2>/i;
const faqHeadingMatch = formattedContentHtml?.match(faqHeadingPattern);
const articleHtml = faqHeadingMatch?.index !== undefined ? formattedContentHtml!.slice(0, faqHeadingMatch.index) : formattedContentHtml;
const faqItems = faqHeadingMatch && formattedContentHtml
  ? [...formattedContentHtml.slice(faqHeadingMatch.index + faqHeadingMatch[0].length).matchAll(/<h3[^>]*>([\s\S]*?)<\/h3>\s*<p>([\s\S]*?)<\/p>/gi)].map((match) => ({ question: match[1], answer: match[2] }))
  : [];
const sanityFaqItems = sanityPost?.faqs?.filter((item) => item.question && item.answer).map((item) => ({ question: item.question!, answer: item.answer! })) || [];
const isPortfolioProject = record?.type === 'portfolio';
const isArticle = record?.type === 'post' || Boolean(sanityPost);
const articlePublishedAt = sanityPost?.publishedAt || record?.publishedAt;
const rawArticleModifiedAt = sanityPost?.modifiedAt || record?.modifiedAt;
const articleModifiedAt = rawArticleModifiedAt && articlePublishedAt && new Date(rawArticleModifiedAt).getTime() >= new Date(articlePublishedAt).getTime() ? rawArticleModifiedAt : undefined;
const articleImage = sanityPost?.featuredImage?.asset?.url || record?.image;
const articleImageAlt = sanityPost?.featuredImage?.alt || heading;
const articleCategory = sanityPost?.categories?.[0]?.title || 'Journal';
const wordCount = (articleHtml || JSON.stringify(sanityPost?.body || '')).replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const articleReadingTime = Math.max(1, Math.ceil(wordCount / 220));
const tocSource = articleHtml || '';
const tocHeadings = [...tocSource.matchAll(/<h([23])[^>]*>([\s\S]*?)<\/h\1>/gi)]
  .map((match, index) => ({ level: Number(match[1]) as 2 | 3, text: match[2].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim(), id: `article-section-${index + 1}` }))
  .filter((heading) => heading.text && !/^faqs?$/i.test(heading.text));
let tocIndex = 0;
const articleHtmlWithIds = articleHtml?.replace(/<h([23])([^>]*)>([\s\S]*?)<\/h\1>/gi, (full, level, attributes, value) => {
  const text = value.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').trim();
  if (/^faqs?$/i.test(text)) return full;
  const id = tocHeadings[tocIndex++]?.id;
  return id ? `<h${level}${attributes} id="${id}">${value}</h${level}>` : full;
});
---
<BaseLayout title={title} description={description} noindex={path === '/thank-you/' || sanityPost?.seo?.noIndex} canonical={sanityPost?.seo?.canonicalUrl} article={sanityPost} articleMeta={isArticle ? { headline: heading, description, publishedAt: articlePublishedAt, modifiedAt: articleModifiedAt, image: articleImage, author: sanityPost?.author?.name } : undefined}>
  {isArticle && <ArticleHero title={heading} description={description} image={articleImage} imageAlt={articleImageAlt} path={path} category={articleCategory} publishedAt={articlePublishedAt} modifiedAt={articleModifiedAt} readingTime={articleReadingTime} author={sanityPost?.author} />}
  {path !== '/about/' && path !== '/clients/' && path !== '/collections/' && path !== '/contact/' && !journalPageNumber && !isPortfolioProject && !isArticle && <PageHero eyebrow={eyebrow} title={heading} description={description} image={sanityPost?.featuredImage?.asset?.url || record?.image} meta={sanityPost ? `Published ${sanityPost.publishedAt.slice(0, 10)}` : undefined} article={isArticle} />}
  {path === '/about/' && <AboutPage />}
  {path === '/clients/' && <ClientsPage logos={clientLogos} />}
  {path === '/services/' && <ServicesPage />}
  {journalPageNumber === 1 && <JournalPage />}
  {path === '/collections/' && <CollectionsPage projects={projects} />}
  {path === '/contact/' && <ContactPage />}
  {isPortfolioProject && record && <ProjectPage project={record} projects={projects} />}


  {path !== '/contact/' && path !== '/about/' && path !== '/clients/' && path !== '/services/' && (
    <>
      {isArticle && articleHtml && (
        <>
          <section class="article-content">
            <div class="container article-layout">
              <div class="article-layout__main">
                <article class="prose" set:html={articleHtmlWithIds} />
              </div>
              <aside class="article-layout__aside">
                <ArticleToc headings={tocHeadings} />
              </aside>
            </div>
          </section>
          <BlogFaqs items={faqItems} />
        </>
      )}
      {isArticle && sanityPost?.body && !contentHtml && (
        <>
          <section class="article-content">
            <div class="container article-layout">
              <div class="article-layout__main">
                <article class="prose">
                  <PostBody value={sanityPost.body} />
                </article>
              </div>
              <aside class="article-layout__aside">
                <ArticleToc headings={tocHeadings} />
              </aside>
            </div>
          </section>
          <BlogFaqs items={sanityFaqItems} />
        </>
      )}
      {articleHtml && !isArticle && !isPortfolioProject && path !== '/journal/' && path !== '/collections/' && (
        <>
          <section class="section content-section">
            <div class="container content-layout">
              <aside class="content-rail">
                <p class="eyebrow">Orange Offices</p>
                <p>Thoughtful workplace design, planned around your people and business.</p>
                <a class="text-link" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a>
              </aside>
              <article class="prose" set:html={articleHtml} />
            </div>
          </section>
          <BlogFaqs items={faqItems} />
        </>
      )}
      {isArticle && <section class="article-extras"><div class="container"><ArticleShare title={heading} path={path} />{sanityPost?.author?.name && <section class="article-author"><p class="eyebrow">Written by</p><h2>{sanityPost.author.name}</h2>{sanityPost.author.designation && <p>{sanityPost.author.designation}</p>}</section>}{relatedArticles.length > 0 && <section class="related-articles" aria-labelledby="related-articles-heading"><p class="eyebrow">Continue reading</p><h2 id="related-articles-heading">Related articles</h2><div class="grid grid--3 article-grid">{relatedArticles.map((article) => <article class="card article-card">{article.featuredImage?.asset?.url && <img src={`${article.featuredImage.asset.url}?auto=format&fit=crop&w=800&h=520&q=82`} alt={article.featuredImage.alt ?? ''} width="800" height="520" loading="lazy" />}<div><p class="article-meta">{new Date(article.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</p><h3><a href={`/${article.slug}/`}>{article.title}</a></h3><p>{article.excerpt || article.seo?.description}</p><a class="text-link" href={`/${article.slug}/`}>Read article <span aria-hidden="true">↗</span></a></div></article>)}</div></section>}</div></section>}
      {path === '/about/' && <section class="section section--dark"><div class="container feature-split"><div><p class="eyebrow">Our approach</p><h2>Spaces that work as hard as your people.</h2><p>We unite strategic planning, detailed design and reliable execution to deliver office environments with a strong sense of place.</p><a class="button button--ghost" href="/contact/">Start a conversation</a></div>{record?.image && <img src={record.image} alt="Orange Offices workspace" width="1200" height="800" loading="lazy" />}</div></section>}
      {journalPageNumber > 0 && <section class="section journal-archive"><div class="container"><div class="section-heading"><div><p class="eyebrow">All articles · {articles.length}</p><h2>{journalPageNumber === 1 ? 'Latest from the journal' : 'More from the journal'}</h2></div></div><div class="grid grid--3 article-grid">{visibleArticles.map((article) => <article class="card article-card">{article.featuredImage?.asset?.url && <img src={`${article.featuredImage.asset.url}?auto=format&fit=crop&w=800&h=520&q=82`} alt={article.featuredImage.alt ?? ''} width="800" height="520" loading="lazy" />}<div><p class="article-meta">{new Date(article.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</p><h3><a href={`/${article.slug}/`}>{article.title}</a></h3><p>{article.excerpt || article.seo?.description}</p><a class="text-link" href={`/${article.slug}/`}>Read article <span aria-hidden="true">↗</span></a></div></article>)}</div>{totalJournalPages > 1 && <nav class="pagination" aria-label="Journal pages">{journalPageNumber > 1 && <a href={journalPageNumber === 2 ? '/journal/' : `/journal/page/${journalPageNumber - 1}/`}>← Previous</a>}<span>Page {journalPageNumber} of {totalJournalPages}</span>{journalPageNumber < totalJournalPages && <a href={`/journal/page/${journalPageNumber + 1}/`}>Next →</a>}</nav>}</div></section>}
      {!record && !blogPageNumber && <section class="section service-overview"><div class="container"><div class="section-heading"><div><p class="eyebrow">Our approach</p><h2>{service ? 'A considered approach from brief to delivery.' : 'Let’s create a better workplace.'}</h2></div></div><div class="grid grid--3">{[['Discover', 'We understand your workplace, people and practical requirements.'], ['Design', 'Our team creates a purposeful design with material and cost clarity.'], ['Deliver', 'We coordinate every detail through a considered, reliable handover.']].map(([step, copy], index) => <article class="card"><span class="card__number">0{index + 1}</span><h3>{step}</h3><p>{copy}</p></article>)}</div></div></section>}
      {path !== '/journal/' && !blogPageNumber && path !== '/collections/' && !isPortfolioProject && <section class="section page-cta"><div class="container"><p class="eyebrow">Start your project</p><h2>Ready to create a workplace that works beautifully?</h2><p>Speak with our team about your next office space in Delhi NCR.</p><a class="button" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a></div></section>}
    </>
  )}
  <AnimationRuntime />
</BaseLayout>

<script is:inline>
  document.querySelectorAll('.article-content .prose h2').forEach((heading) => {
    if (!/^faqs?\s*$/i.test(heading.textContent?.trim() || '')) return;

    const faqSection = document.createElement('section');
    faqSection.className = 'article-faqs';
    faqSection.setAttribute('aria-label', 'Frequently asked questions');
    heading.replaceWith(faqSection);
    faqSection.append(heading);

    let current = faqSection.nextElementSibling;
    while (current && !/^H2$/i.test(current.tagName)) {
      const next = current.nextElementSibling;
      if (/^H3$/i.test(current.tagName)) {
        const item = document.createElement('details');
        item.className = 'article-faqs__item';
        const question = document.createElement('summary');
        question.innerHTML = `<span class="article-faqs__question">${current.innerHTML}</span><span class="article-faqs__icon" aria-hidden="true"><svg class="article-faqs__icon--plus" viewBox="0 0 448 512"><path d="M416 208H272V64c0-17.67-14.33-32-32-32h-32c-17.67 0-32 14.33-32 32v144H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h144v144c0 17.67 14.33 32 32 32h32c17.67 0 32-14.33 32-32V304h144c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z"></path></svg><svg class="article-faqs__icon--minus" viewBox="0 0 448 512"><path d="M416 208H32c-17.67 0-32 14.33-32 32v32c0 17.67 14.33 32 32 32h384c17.67 0 32-14.33 32-32v-32c0-17.67-14.33-32-32-32z"></path></svg></span>`;
        item.append(question);
        current.remove();

        const answer = document.createElement('div');
        answer.className = 'article-faqs__answer';
        let answerNode = next;
        while (answerNode?.tagName === 'P') {
          const following = answerNode.nextElementSibling;
          answer.append(answerNode);
          answerNode = following;
        }
        item.append(answer);
        faqSection.append(item);
        if (faqSection.querySelectorAll('details').length === 1) item.open = true;
        current = answerNode;
        continue;
      }
      current = next;
    }

    faqSection.addEventListener('toggle', (event) => {
      const openedItem = event.target;
      if (!(openedItem instanceof HTMLDetailsElement) || !openedItem.open) return;
      faqSection.querySelectorAll('details[open]').forEach((item) => {
        if (item !== openedItem) item.open = false;
      });
    }, true);
  });
</script>
