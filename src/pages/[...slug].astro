---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AboutPage from '../components/AboutPage.astro';
import ClientsPage from '../components/ClientsPage.astro';
import ServicesPage from '../components/ServicesPage.astro';
import JournalPage from '../components/JournalPage.astro';
import CollectionsPage from '../components/CollectionsPage.astro';
import ContactPage from '../components/ContactPage.astro';
import { pages, services } from '../lib/site';
import wordpressRecords from '../data/wordpress-content.json';

export const prerender = true;
export function getStaticPaths() {
  const postCount = wordpressRecords.filter((record) => record.type === 'post').length;
  const journalPages = Array.from({ length: Math.ceil(Math.max(0, postCount - 6) / 10) }, (_, index) => `/journal/page/${index + 2}/`);
  const paths = [...Object.keys(pages), ...journalPages, ...services.map(([, href]) => href), ...wordpressRecords.map((record) => record.path)];
  return [...new Set(paths)].map((path) => ({ params: { slug: path.slice(1, -1) } }));
}

const path = `/${(Astro.params.slug ?? '').split('/').filter(Boolean).join('/')}/`;
const journalPageMatch = path.match(/^\/journal\/page\/(\d+)\/$/);
const journalPageNumber = journalPageMatch ? Number(journalPageMatch[1]) : path === '/journal/' ? 1 : 0;
const blogPageNumber = journalPageNumber;
const page = pages[path] || (journalPageNumber ? pages['/journal/'] : undefined);
const record = wordpressRecords.find((item) => item.path === path);
if (!page && !record) return Astro.redirect('/404/');
const service = services.find(([, href]) => href === path);
const articles = wordpressRecords.filter((item) => item.type === 'post').sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
const totalJournalPages = 1 + Math.ceil(Math.max(0, articles.length - 6) / 10);
const visibleArticles = journalPageNumber === 1 ? articles.slice(0, 6) : journalPageNumber > 1 ? articles.slice(6 + (journalPageNumber - 2) * 10, 6 + (journalPageNumber - 1) * 10) : [];
const projects = wordpressRecords.filter((item) => item.type === 'portfolio');
const heading = record?.title || service?.[0] || (journalPageNumber > 1 ? `${page!.heading} — Page ${journalPageNumber}` : page!.heading);
const description = record?.description || service?.[2] || page!.intro;
const eyebrow = service ? 'Services' : record?.type === 'post' ? 'Journal' : record?.type === 'portfolio' ? 'Selected project' : path === '/about/' ? 'Orange Offices' : record ? 'Orange Offices' : page!.eyebrow;
const title = record?.seoTitle || (service ? `${service[0]} | Orange Offices` : journalPageNumber > 1 ? `Journal — Page ${journalPageNumber} | Orange Offices` : page!.title);
const clientLogos = path === '/clients/' && record?.contentHtml ? [...record.contentHtml.matchAll(/<img[^>]+src="([^"]+)"[^>]*>/g)].map((match) => match[1]).slice(5) : [];
---
<BaseLayout title={title} description={description} noindex={path === '/thank-you/'}>
  {path !== '/about/' && path !== '/clients/' && path !== '/collections/' && path !== '/contact/' && !journalPageNumber && <PageHero eyebrow={eyebrow} title={heading} description={description} image={record?.image} meta={record?.type === 'post' ? `Published ${record.publishedAt.slice(0, 10)}` : undefined} />}
  {path === '/about/' && <AboutPage />}
  {path === '/clients/' && <ClientsPage logos={clientLogos} />}
  {path === '/services/' && <ServicesPage />}
  {journalPageNumber === 1 && <JournalPage />}
  {path === '/collections/' && <CollectionsPage projects={projects} />}
  {path === '/contact/' && <ContactPage />}


  {path !== '/contact/' && path !== '/about/' && path !== '/clients/' && path !== '/services/' && (
    <>
      {record?.contentHtml && path !== '/journal/' && path !== '/collections/' && <section class="section content-section"><div class="container content-layout"><aside class="content-rail"><p class="eyebrow">Orange Offices</p><p>Thoughtful workplace design, planned around your people and business.</p><a class="text-link" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a></aside><article class="prose" set:html={record.contentHtml} /></div></section>}
      {path === '/about/' && <section class="section section--dark"><div class="container feature-split"><div><p class="eyebrow">Our approach</p><h2>Spaces that work as hard as your people.</h2><p>We unite strategic planning, detailed design and reliable execution to deliver office environments with a strong sense of place.</p><a class="button button--ghost" href="/contact/">Start a conversation</a></div>{record?.image && <img src={record.image} alt="Orange Offices workspace" width="1200" height="800" loading="lazy" />}</div></section>}
      {journalPageNumber > 0 && <section class="section journal-archive"><div class="container"><div class="section-heading"><div><p class="eyebrow">All articles · {articles.length}</p><h2>{journalPageNumber === 1 ? 'Latest from the journal' : 'More from the journal'}</h2></div></div><div class="grid grid--3 article-grid">{visibleArticles.map((article) => <article class="card article-card">{article.image && <img src={article.image} alt="" width="800" height="520" loading="lazy" />}<div><p class="article-meta">{new Date(article.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</p><h3><a href={article.path}>{article.title}</a></h3><p>{article.description}</p><a class="text-link" href={article.path}>Read article <span aria-hidden="true">↗</span></a></div></article>)}</div>{totalJournalPages > 1 && <nav class="pagination" aria-label="Journal pages">{journalPageNumber > 1 && <a href={journalPageNumber === 2 ? '/journal/' : `/journal/page/${journalPageNumber - 1}/`}>← Previous</a>}<span>Page {journalPageNumber} of {totalJournalPages}</span>{journalPageNumber < totalJournalPages && <a href={`/journal/page/${journalPageNumber + 1}/`}>Next →</a>}</nav>}</div></section>}
      {!record && !blogPageNumber && <section class="section service-overview"><div class="container"><div class="section-heading"><div><p class="eyebrow">Our approach</p><h2>{service ? 'A considered approach from brief to delivery.' : 'Let’s create a better workplace.'}</h2></div></div><div class="grid grid--3">{[['Discover', 'We understand your workplace, people and practical requirements.'], ['Design', 'Our team creates a purposeful design with material and cost clarity.'], ['Deliver', 'We coordinate every detail through a considered, reliable handover.']].map(([step, copy], index) => <article class="card"><span class="card__number">0{index + 1}</span><h3>{step}</h3><p>{copy}</p></article>)}</div></div></section>}
      {path !== '/journal/' && !blogPageNumber && path !== '/collections/' && <section class="section page-cta"><div class="container"><p class="eyebrow">Start your project</p><h2>Ready to create a workplace that works beautifully?</h2><p>Speak with our team about your next office space in Delhi NCR.</p><a class="button" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a></div></section>}
    </>
  )}
</BaseLayout>
