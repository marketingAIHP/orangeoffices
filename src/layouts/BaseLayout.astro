---
import '../styles/global.css';
import { nav, navChildren, site } from '../lib/site';
import wordpressRecords from '../data/wordpress-content.json';
import type { SanityPost } from '../lib/sanity/types';
interface ArticleMeta { headline: string; description: string; publishedAt?: string; modifiedAt?: string; image?: string; author?: string; }
interface Props { title: string; description: string; noindex?: boolean; canonical?: string; article?: SanityPost; articleMeta?: ArticleMeta; }
const { title, description, noindex = false, canonical: canonicalOverride, article, articleMeta } = Astro.props;
const canonical = canonicalOverride || new URL(Astro.url.pathname, site).href;
const graphItems: Record<string, unknown>[] = [{ '@type': 'Organization', '@id': `${site}/#organization`, name: 'Orange Offices', url: site, email: 'design@orangeoffices.in', telephone: '+91 78610 04918', address: { '@type': 'PostalAddress', streetAddress: 'AIHP Tower, 249 G, Udyog Vihar Phase 4', addressLocality: 'Gurgaon', addressRegion: 'Haryana', postalCode: '122015', addressCountry: 'IN' } }, { '@type': 'WebSite', '@id': `${site}/#website`, url: site, name: 'Orange Offices', publisher: { '@id': `${site}/#organization` } }];
const resolvedArticle = articleMeta || (article ? { headline: article.title, description, publishedAt: article.publishedAt, modifiedAt: article.modifiedAt, image: article.featuredImage?.asset?.url, author: article.author?.name } : undefined);
if (resolvedArticle) graphItems.push({ '@type': 'BlogPosting', '@id': `${canonical}#article`, headline: resolvedArticle.headline, description: resolvedArticle.description, datePublished: resolvedArticle.publishedAt, dateModified: resolvedArticle.modifiedAt || resolvedArticle.publishedAt, mainEntityOfPage: canonical, author: resolvedArticle.author ? { '@type': 'Person', name: resolvedArticle.author } : { '@id': `${site}/#organization` }, publisher: { '@id': `${site}/#organization` }, ...(resolvedArticle.image ? { image: new URL(resolvedArticle.image, site).href } : {}) });
const graph = { '@context': 'https://schema.org', '@graph': graphItems };
const socialImage = new URL(resolvedArticle?.image || '/wp-content/uploads/2024/12/DSC01239.webp', site).href;
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isJournalArticle = Boolean(article) || wordpressRecords.some((record) => record.type === 'post' && record.path === currentPath);
const isActiveNavItem = (href: string) => href === '/' ? currentPath === '/' || currentPath === '/home/' : currentPath === href || (href === '/journal/' && (isJournalArticle || currentPath.startsWith('/journal/'))) || (href === '/project/' && currentPath.startsWith('/project/'));
const showMobileAction = ['/', '/services/', '/project/'].includes(currentPath) || currentPath.startsWith('/project/');
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="icon" href="/wp-content/uploads/2025/01/cropped-orange-office-Icon-01.png" />{noindex && <meta name="robots" content="noindex,follow" />}<meta property="og:type" content={resolvedArticle ? 'article' : 'website'} /><meta property="og:site_name" content="Orange Offices" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><script is:inline>{`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MCXZT8FR');`}</script><script type="application/ld+json" set:html={JSON.stringify(graph)} /></head><body><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MCXZT8FR" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript><a class="skip-link" href="#main">Skip to content</a><header class="header"><div class="container header__inner"><a class="brand brand--header" href="/" aria-label="Orange Offices home"><img src="/brand/orange-offices-logo-white.png" alt="Orange Offices" width="256" height="78" /></a><nav class="nav" aria-label="Primary navigation">{nav.map(([label, href]) => navChildren[href] ? <div class="nav-group"><a href={href} aria-current={isActiveNavItem(href) ? 'page' : undefined}>{label}</a><div class="nav-submenu">{navChildren[href].map(([childLabel, childHref]) => <a href={childHref} aria-current={currentPath.startsWith(childHref) ? 'page' : undefined}>{childLabel}</a>)}</div></div> : <a href={href} aria-current={isActiveNavItem(href) ? 'page' : undefined}>{label}</a>)}</nav><a class="button header__cta" href="/contact/">Book consultation <span aria-hidden="true">→</span></a><details class="mobile-nav"><summary aria-label="Open navigation" aria-expanded="false"><span></span><span></span><span></span></summary><nav aria-label="Mobile navigation">{nav.map(([label, href]) => <div class="mobile-nav__group"><a href={href} aria-current={isActiveNavItem(href) ? 'page' : undefined}>{label}</a>{navChildren[href]?.map(([childLabel, childHref]) => <a class="mobile-nav__child" href={childHref} aria-current={currentPath.startsWith(childHref) ? 'page' : undefined}>{childLabel}</a>)}</div>)}<a class="button" href="/contact/">Book a free consultation <span aria-hidden="true">→</span></a></nav></details></div></header><main id="main"><slot /></main><footer class="footer"><div class="container footer__grid"><div><a class="brand" href="/"><img src="/brand/orange-offices-logo-white.png" alt="Orange Offices" width="256" height="78" /></a><p>Orange Offices, a brand by AIHP, creates bespoke and responsible office interiors for businesses in Delhi NCR.</p><a class="footer__contact" href="mailto:design@orangeoffices.in">design@orangeoffices.in →</a></div><div><h3>Explore</h3><p><a href="/about/">About us</a><a href="/services/">Services</a><a href="/journal/">Journal</a><a href="/project/">Projects</a><a href="/gallery/">Gallery</a><a href="/contact/">Contact</a></p></div><div><h3>Get in touch</h3><p>AIHP Tower, 249 G, Udyog Vihar Phase 4, Gurgaon 122015</p><p><a href="tel:+917861004918">+91 78610 04918</a><a href="tel:+919650383322">+91 96503 83322</a></p></div></div><div class="container footer__bottom"><small>© {new Date().getFullYear()} Orange Offices. All rights reserved.</small><a href="/privacy-policy/">Privacy</a><a href="/terms/">Terms</a></div></footer><script is:inline>
  const mobileNav = document.querySelector('.mobile-nav');
  const mobileToggle = mobileNav?.querySelector('summary');
  const mobileLinks = [...(mobileNav?.querySelectorAll('a') || [])];
  const closeMobileNav = (restoreFocus = false) => {
    mobileNav?.removeAttribute('open');
    mobileToggle?.setAttribute('aria-expanded', 'false');
    mobileToggle?.setAttribute('aria-label', 'Open navigation');
    if (restoreFocus) mobileToggle?.focus();
  };
  mobileNav?.addEventListener('toggle', () => {
    const open = mobileNav.open;
    mobileToggle?.setAttribute('aria-expanded', String(open));
    mobileToggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    if (open) requestAnimationFrame(() => mobileLinks[0]?.focus());
  });
  document.addEventListener('keydown', (event) => {
    if (!mobileNav?.open) return;
    if (event.key === 'Escape') closeMobileNav(true);
    if (event.key !== 'Tab') return;
    const focusable = [mobileToggle, ...mobileLinks].filter(Boolean);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
  mobileLinks.forEach((link) => link.addEventListener('click', () => closeMobileNav()));
</script>{showMobileAction && <aside class="mobile-action" aria-label="Quick contact"><a href="/contact/">Book consultation</a><a href="tel:+917861004918">Call</a></aside>}</body></html>
