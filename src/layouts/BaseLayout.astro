---
import '../styles/global.css';
import { nav, navChildren, site } from '../lib/site';
import wordpressRecords from '../data/wordpress-content.json';
import type { SanityPost } from '../lib/sanity/types';
interface Props { title: string; description: string; noindex?: boolean; canonical?: string; article?: SanityPost; }
const { title, description, noindex = false, canonical: canonicalOverride, article } = Astro.props;
const canonical = canonicalOverride || new URL(Astro.url.pathname, site).href;
const graphItems: Record<string, unknown>[] = [{ '@type': 'Organization', '@id': `${site}/#organization`, name: 'Orange Offices', url: site, email: 'design@orangeoffices.in', telephone: '+91 78610 04918', address: { '@type': 'PostalAddress', streetAddress: 'Plot No: 448 - 451, Udyog Vihar Phase V Rd', addressLocality: 'Gurugram', addressRegion: 'Haryana', postalCode: '122016', addressCountry: 'IN' } }, { '@type': 'WebSite', '@id': `${site}/#website`, url: site, name: 'Orange Offices', publisher: { '@id': `${site}/#organization` } }];
if (article) graphItems.push({ '@type': 'BlogPosting', '@id': `${canonical}#article`, headline: article.title, description, datePublished: article.publishedAt, dateModified: article.modifiedAt || article.publishedAt, mainEntityOfPage: canonical, author: article.author?.name ? { '@type': 'Person', name: article.author.name } : { '@id': `${site}/#organization` }, publisher: { '@id': `${site}/#organization` }, ...(article.featuredImage?.asset?.url ? { image: article.featuredImage.asset.url } : {}) });
const graph = { '@context': 'https://schema.org', '@graph': graphItems };
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isJournalArticle = Boolean(article) || wordpressRecords.some((record) => record.type === 'post' && record.path === currentPath);
const isActiveNavItem = (href: string) => href === '/' ? currentPath === '/' || currentPath === '/home/' : currentPath === href || (href === '/journal/' && (isJournalArticle || currentPath.startsWith('/journal/'))) || (href === '/collections/' && currentPath.startsWith('/project/'));
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />{noindex && <meta name="robots" content="noindex,follow" />}<meta property="og:type" content="website" /><meta property="og:site_name" content="Orange Offices" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><script type="application/ld+json" set:html={JSON.stringify(graph)} /></head><body><a class="skip-link" href="#main">Skip to content</a><header class="header"><div class="container header__inner"><a class="brand brand--header" href="/" aria-label="Orange Offices home"><img src="/brand/orange-offices-logo-white.png" alt="Orange Offices" width="256" height="78" /></a><nav class="nav" aria-label="Primary navigation">{nav.map(([label, href]) => navChildren[href] ? <div class="nav-group"><a href={href} aria-current={isActiveNavItem(href) ? 'page' : undefined}>{label}</a><div class="nav-submenu">{navChildren[href].map(([childLabel, childHref]) => <a href={childHref} aria-current={currentPath.startsWith(childHref) ? 'page' : undefined}>{childLabel}</a>)}</div></div> : <a href={href} aria-current={isActiveNavItem(href) ? 'page' : undefined}>{label}</a>)}</nav><a class="button header__cta" href="/contact/">Get started <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary aria-label="Open navigation"><span></span><span></span><span></span></summary><nav aria-label="Mobile navigation">{nav.map(([label, href]) => <div class="mobile-nav__group"><a href={href} aria-current={isActiveNavItem(href) ? 'page' : undefined}>{label}</a>{navChildren[href]?.map(([childLabel, childHref]) => <a class="mobile-nav__child" href={childHref} aria-current={currentPath.startsWith(childHref) ? 'page' : undefined}>{childLabel}</a>)}</div>)}<a class="button" href="/contact/">Get started <span aria-hidden="true">↗</span></a></nav></details></div></header><main id="main"><slot /></main><footer class="footer"><div class="container footer__grid"><div><a class="brand" href="/"><img src="/brand/orange-offices-logo-white.png" alt="Orange Offices" width="256" height="78" /></a><p>Orange Offices – a brand by AIHP, creates bespoke, sustainable office spaces for businesses in Delhi and Gurugram.</p><a class="footer__contact" href="mailto:design@orangeoffices.in">design@orangeoffices.in ↗</a></div><div><h3>Explore</h3><p><a href="/about/">About us</a><a href="/services/">Services</a><a href="/journal/">Journal</a><a href="/journal/blog/">Blog</a><a href="/collections/">Projects</a><a href="/contact/">Contact</a></p></div><div><h3>Get in touch</h3><p>Plot No: 448 - 451, Udyog Vihar Phase V Rd, Gurugram, Haryana 122016</p><p><a href="tel:+917861004918">+91 78610 04918</a><a href="tel:+919650383322">+91 96503 83322</a></p></div></div><div class="container footer__bottom"><small>© {new Date().getFullYear()} Orange Offices. All rights reserved.</small><a href="/privacy-policy/">Privacy</a><a href="/terms/">Terms</a></div></footer><script is:inline>document.addEventListener('keydown', (event) => { if (event.key === 'Escape') document.querySelector('.mobile-nav')?.removeAttribute('open'); }); document.querySelectorAll('.mobile-nav a').forEach((link) => link.addEventListener('click', () => document.querySelector('.mobile-nav')?.removeAttribute('open')));</script></body></html>
