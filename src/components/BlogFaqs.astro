---
interface FaqItem { question: string; answer: string }
const {items = []} = Astro.props as {items?: FaqItem[]}
const number = (index: number) => String(index + 1).padStart(2, '0')
---
{items.length > 0 && (
  <section class="blog-faq-section" aria-label="Frequently asked questions">
    <div class="container">
      <div class="blog-faq">
        <div class="blog-faq__content">
          <div class="blog-faq__intro">
            <p class="eyebrow">Frequently asked</p>
            <h2>The answers before you ask.</h2>
            <p>The questions our team hears most. If you need anything else, we’re here to help.</p>
          </div>
          <div class="blog-faq__list">
            {items.map((item, index) => (
              <details class="blog-faq__item" open={index === 0}>
                <summary>
                  <span class="blog-faq__number">{number(index)}</span>
                  <span class="blog-faq__question" set:html={item.question} />
                  <span class="blog-faq__toggle" aria-hidden="true">{index === 0 ? '−' : '+'}</span>
                </summary>
                <div class="blog-faq__answer" set:html={item.answer} />
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}
<script>
  document.querySelectorAll<HTMLElement>('.blog-faq').forEach((faq) => {
    faq.addEventListener('toggle', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLDetailsElement)) return;
      const toggle = target.querySelector('.blog-faq__toggle');
      if (toggle) toggle.textContent = target.open ? '−' : '+';
      if (target.open) {
        faq.querySelectorAll('details[open]').forEach((item) => {
          if (item !== target) {
            item.open = false;
            const otherToggle = item.querySelector('.blog-faq__toggle');
            if (otherToggle) otherToggle.textContent = '+';
          }
        });
      }
    }, true);
  });
</script>
