<form class="form" method="post" action="/api/leads/" data-form="consultation"><div><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div><div><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div><div><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div><div><label for="message">Tell us about your workspace</label><textarea id="message" name="message" required></textarea></div><input type="hidden" name="form_id" value="consultation" /><button class="button" type="submit">Request a consultation</button></form>
