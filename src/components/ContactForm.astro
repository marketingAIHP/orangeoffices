<script is:inline>
  document.querySelectorAll('[data-form="zoho-lead"]').forEach((form) => {
    const status = form.querySelector('.form__status');
    const submit = form.querySelector('button[type="submit"]');
    const fields = [...form.querySelectorAll('input:not([type="hidden"]):not(.form__honeypot)')];
    const errorIds = { 'First Name': 'first-name-error', 'Last Name': 'last-name-error', Company: 'company-error', Email: 'email-error', Mobile: 'mobile-error', City: 'city-error' };
    const setError = (field, message = '') => {
      const error = form.querySelector(`#${errorIds[field.name]}`);
      if (error) error.textContent = message;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
    };
    const validate = () => {
      let firstInvalid;
      fields.forEach((field) => {
        const value = field.value.trim();
        let message = '';
        if (field.required && !value) message = 'This field is required.';
        else if ((field.name === 'First Name' || field.name === 'Last Name') && value.length < 2) message = 'Enter at least 2 characters.';
        else if (field.name === 'Email' && !field.validity.valid) message = 'Enter a valid email address.';
        setError(field, message);
        if (message && !firstInvalid) firstInvalid = field;
      });
      return firstInvalid;
    };
    fields.forEach((field) => field.addEventListener('input', () => setError(field)));
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.hidden = true;
      const firstInvalid = validate();
      if (firstInvalid) {
        status.textContent = 'Please correct the highlighted fields.';
        status.hidden = false;
        status.focus();
        firstInvalid.focus();
        return;
      }
      const query = new URLSearchParams(location.search);
      if (query.get('service') === 'smarturl' && !form.elements.service) {
        const service = document.createElement('input');
        service.type = 'hidden'; service.name = 'service'; service.value = 'smarturl'; form.appendChild(service);
      }
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.firstChild.textContent = 'Sending… ';
      try {
        if (typeof _wfa_track !== 'undefined' && _wfa_track.wfa_submit) _wfa_track.wfa_submit(event);
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), cache: 'no-cache' });
        const contentType = response.headers.get('content-type') || '';
        const result = contentType.includes('application/json') ? await response.json() : null;
        if (!response.ok || result?.actionsubmit === 'error_msg' || result?.invalidCaptcha === 'true') throw new Error(result?.message || result?.actionvalue || 'We could not accept your enquiry right now.');
        if (typeof _wfa_track !== 'undefined' && _wfa_track.wfa_post_submit) _wfa_track.wfa_post_submit(event);
        location.assign('/thank-you/');
      } catch (error) {
        status.textContent = `${error.message} Call +91 78610 04918 or try again.`;
        status.hidden = false; status.focus(); submit.disabled = false; submit.removeAttribute('aria-busy'); submit.firstChild.textContent = 'Book a free consultation ';
      }
    });
  });
</script>
