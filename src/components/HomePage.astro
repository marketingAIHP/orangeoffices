---
import { services } from '../lib/site';
const logos = ['4-1.jpg','Group-269.jpg','Group-270-1.jpg','Group-276.jpg','Group-277.jpg','Group-273.jpg','Group-274.jpg','Group-275.jpg'].map((file) => `/wp-content/uploads/2025/01/${file}`);
const serviceImages = ['/wp-content/uploads/2025/01/Bespoke-2.webp','/wp-content/uploads/2025/01/Fresenius-Kabi-India-8.webp','/wp-content/uploads/2025/01/Anand-rathi-4.webp','/wp-content/uploads/2025/01/Services4.jpg'];
const process = ['Thoroughly Understand Your Vision','Create Designs at Record Speed','Estimate Costs Within Your Budget','Present Detailed 3D Visuals','Ensure Flawless Project Execution','Deliver in 45 days*'];
const projects = [['Anand Rathi','/project/anand-rathi-wealth/','/wp-content/uploads/2025/01/Anand-rathi-6.webp'],['FarMart','/project/farmart/','/wp-content/uploads/2025/01/Farmart.webp'],['HT Media','/project/ht-media/','/wp-content/uploads/2025/01/HT-Media-3.webp'],['Wishlink','/project/wishlink/','/wp-content/uploads/2025/01/Wishlink-4.webp']];
const testimonials = [['At AIHP, excellence is standard. From top-tier offices to tailored designs, every aspect exceeds expectations. Choosing AIHP was simple - simply exceptional.','SUDHIR SHARMA','Regional Head','/wp-content/uploads/2024/12/Arcelormittal-logo.jpg'],['AIHP has been an invaluable partner in creating a prestigious workspace for Anand Rathi Wealth. Their professionalism, attention to detail and ability to understand our specific needs have contributed significantly to our success.','MUKESH KUMAWAT','Executive Director','/wp-content/uploads/2024/12/Anand-Rathi.jpg'],['We go with AIHP because it takes care of end to end managed services. This means that we can easily focus on our work rather than looking at the facilities.','ASHISH CHAHDA','CEO & Co-Founder','/wp-content/uploads/2024/12/Advatix.jpg'],["AIHP's attention to detail & quick delivery exceeded our expectations. In just three months, they brought our vision to life flawlessly. Their top-notch team and seamless design process made it one of our best office experiences.",'SAHIL CHALANA','Founder','/wp-content/uploads/2024/12/collegedunia.jpg']];
const gallery = ['jpeg-optimizer_DSC01606-qzqrp958jx4xmakz1dhb3uqysj4slztqs3n028jer4.webp','jpeg-optimizer_DSCF2480-qzqrpcwlb9a2wqfiff3tdtst62m9gs8o4m8xzcdu28.webp','jpeg-optimizer_DSC04471-qzqrpb0wxl7i9ii8qeak8u9vzavj1e17gcxz0sgmeo.webp','jpeg-optimizer_DSCF6184-qz63yj93cakc3gctlcrrzv07wibdzh1oljm9mtok8g.webp'];
---
<section class="home-hero" style="--home-hero:url('/wp-content/uploads/2024/12/DSC01239.webp')"><div class="container home-hero__content"><p class="eyebrow">Office interiors in Gurgaon</p><h1>Elevate Your Workspace with the Best Office Interior Design in Gurgaon</h1><div class="hero__actions"><a class="button" href="/contact/">Get Started</a><a class="button button--ghost" href="/services/">Explore Services</a></div></div></section>
<section class="home-promos"><a href="/bespoke-office-interior-design/"><strong>Your Vision, Our Expertise: Offices Made Perfect</strong><span>Transform your workspace with tailor-made interiors that reflect your brand and optimize productivity—delivered in just 30 days</span><b>Explore Our Bespoke Offices ↗</b></a><a href="/eco-friendly-workspace-design/"><strong>Sustainable Office Designs Built for the Future</strong><span>Create eco-friendly work environments that blend innovative design with sustainable practices, ensuring a greener tomorrow.</span><b>Explore Our Eco-friendly Offices ↗</b></a></section>
<section class="section home-about"><div class="container home-split"><div><p class="eyebrow">About</p><h2>Design Your Space, Inspire Your Creative Vision</h2><p>At Orange Offices, we craft premium office interiors in Gurgaon, blending functionality, aesthetics, and efficiency to create inspiring work environments. Whether you're a startup, SME, or large enterprise, our designs align with your brand’s vision while enhancing productivity.</p></div><img src="/wp-content/uploads/2024/12/DSC01122.webp" alt="Best Office Interior Design in Gurgaon" width="1603" height="2000" loading="lazy" /></div></section>
<section class="section home-trusted"><div class="container"><h2>Trusted By 600+ World-Class Brands And Organizations</h2><div class="client-logo-grid">{logos.map((src) => <div class="client-logo"><img src={src} alt="Orange Offices client" width="300" height="182" loading="lazy" /></div>)}</div></div></section>
<section class="home-sustainability" style="--sustainability:url('/wp-content/uploads/2025/01/jpeg-optimizer_DSC01630.webp')"><div class="container"><h2>Designing Sustainable Spaces That Inspire: Where Eco-Friendly Meets Exceptional Office Design</h2><a class="button" href="/eco-friendly-workspace-design/">Discover more</a></div></section>
<section class="home-stats"><div class="container">{[['600+','Clients'],['40L+','Sq. Ft Fitted Out'],['99%','On-time Delivery'],['12+','Years Experience']].map(([n,l]) => <div><strong>{n}</strong><span>{l}</span></div>)}</div></section>
<section class="section section--dark home-services"><div class="container"><p class="eyebrow">What we offer</p><h2>Step Into a Space Where Colours, Textures And Patterns Blend Effortlessly</h2><div class="home-services__grid">{services.map(([title,href],i) => <a href={href}><img src={serviceImages[i]} alt={title} width="900" height="700" loading="lazy" /><span>0{i+1}</span><h3>{title}</h3></a>)}</div></div></section>
<section class="section home-expertise"><div class="container home-split"><div><p class="eyebrow">Our Expertise</p><h2>Design a Space That Reflects Your True Essence</h2><p>At Orange Offices, our expertise lies in designing functional, innovative and aesthetically pleasing environments tailored to your unique needs.</p>{['Interior Design','Architecture','3D Design','Interior Knowledge'].map((x) => <div class="expertise-bar"><span>{x}</span><i></i></div>)}</div><img src="/wp-content/uploads/2025/01/jpeg-optimizer_DSC01630.webp" alt="Orange Offices interior design" width="2000" height="1333" loading="lazy" /></div></section>
<section class="section section--muted home-process"><div class="container"><p class="eyebrow">The Orange Offices Design Process</p><h2>Unleash The Potential Of Your Space Through Thoughtful Design</h2><div>{process.map((title,i) => <article><span>Step 0{i+1}</span><h3>{title}</h3>{i===5 && <p>(after design approval)</p>}</article>)}</div></div></section>
<section class="section home-projects"><div class="container"><p class="eyebrow">Featured Projects</p><h2>Crafting Office Designs That Inspire Productivity</h2><div>{projects.map(([title,href,image],i) => <a href={href}><img src={image} alt={`${title} office design`} width="1000" height="700" loading="lazy" /><span>{i+1}. {title}</span></a>)}</div><a class="projects-cta" href="/collections/"><span>View all projects</span><b aria-hidden="true">↗</b></a></div></section>
<section class="section section--dark home-testimonials"><div class="container"><p class="eyebrow">Testimonials</p><h2>What Clients Say About Us</h2><div>{testimonials.map(([quote,name,role,logo]) => <blockquote><p>“{quote}”</p><footer><img src={logo} alt="" width="120" height="70" loading="lazy" /><cite>{name}<span>{role}</span></cite></footer></blockquote>)}</div></div></section>
<section class="section home-gallery"><div class="container"><p class="eyebrow">Our Gallery</p><h2>Where Every Space Tells a Story</h2><p>We believe in design's power to connect and inspire. From architecture to art, our creations reflect the world around us. Here, we share the stories that fuel our creativity.</p><a class="text-link" href="/gallery/">Explore gallery ↗</a><div>{gallery.map((file) => <img src={`/wp-content/uploads/elementor/thumbs/${file}`} alt="Orange Offices project gallery" width="700" height="700" loading="lazy" />)}</div></div></section>
<section class="section page-cta"><div class="container"><h2>Searching for the Best Office Interior Design Gurgaon?<br />Let’s transform your workspace! Get a free consultation today</h2><a class="button" href="/contact/">Get in Touch</a></div></section>
