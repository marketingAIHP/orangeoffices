---
import { services } from '../lib/site';
const logos = ['4-1.jpg','Group-269.jpg','Group-270-1.jpg','Group-276.jpg','Group-277.jpg','Group-273.jpg','Group-274.jpg','Group-275.jpg'].map((file) => `/wp-content/uploads/2025/01/${file}`);
const serviceImages = ['/wp-content/uploads/2025/01/Bespoke-2.webp','/wp-content/uploads/2025/01/Fresenius-Kabi-India-8.webp','/wp-content/uploads/2025/01/Anand-rathi-4.webp','/wp-content/uploads/2025/01/Services4.jpg'];
const process = ['Understand your brief and business goals','Shape the workplace plan','Align the design with your budget','Review detailed 3D visualisations','Coordinate project execution','Handover the completed workplace'];
const projects = [['Anand Rathi','/project/anand-rathi-wealth/','/wp-content/uploads/2025/01/Anand-rathi-6.webp'],['FarMart','/project/farmart/','/wp-content/uploads/2025/01/Farmart.webp'],['HT Media','/project/ht-media/','/wp-content/uploads/2025/01/HT-Media-3.webp'],['Wishlink','/project/wishlink/','/wp-content/uploads/2025/01/Wishlink-4.webp']];
const testimonials = [['At AIHP, excellence is standard. From top-tier offices to tailored designs, every aspect exceeds expectations. Choosing AIHP was simple - simply exceptional.','SUDHIR SHARMA','Regional Head','/wp-content/uploads/2024/12/Arcelormittal-logo.jpg'],['AIHP has been an invaluable partner in creating a prestigious workspace for Anand Rathi Wealth. Their professionalism, attention to detail and ability to understand our specific needs have contributed significantly to our success.','MUKESH KUMAWAT','Executive Director','/wp-content/uploads/2024/12/Anand-Rathi.jpg'],['We go with AIHP because it takes care of end to end managed services. This means that we can easily focus on our work rather than looking at the facilities.','ASHISH CHAHDA','CEO & Co-Founder','/wp-content/uploads/2024/12/Advatix.jpg'],["AIHP's attention to detail & quick delivery exceeded our expectations. In just three months, they brought our vision to life flawlessly. Their top-notch team and seamless design process made it one of our best office experiences.",'SAHIL CHALANA','Founder','/wp-content/uploads/2024/12/collegedunia.jpg']];
const gallery = ['jpeg-optimizer_DSC01606-qzqrp958jx4xmakz1dhb3uqysj4slztqs3n028jer4.webp','jpeg-optimizer_DSCF2480-qzqrpcwlb9a2wqfiff3tdtst62m9gs8o4m8xzcdu28.webp','jpeg-optimizer_DSC04471-qzqrpb0wxl7i9ii8qeak8u9vzavj1e17gcxz0sgmeo.webp','jpeg-optimizer_DSCF6184-qz63yj93cakc3gctlcrrzv07wibdzh1oljm9mtok8g.webp'];
---
<section class="home-hero" style="--home-hero:url('/wp-content/uploads/2024/12/DSC01239.webp')"><div class="container home-hero__content"><p class="eyebrow">Workplace design · Delhi NCR</p><h1>Workplaces designed around your business</h1><p>Strategy, interior design and dependable delivery for offices that help people do their best work.</p><div class="hero__actions"><a class="button" href="/contact/">Book a free consultation</a><a class="button button--ghost" href="/collections/">View our projects</a></div><a class="home-hero__credit" href="/collections/">Explore completed Orange Offices workplaces ↗</a></div></section>
<section class="home-promos"><a href="/bespoke-office-interior-design/"><strong>Bespoke office interiors</strong><span>Purposeful workplaces tailored to your brand, team and operational needs.</span><b>Explore bespoke design →</b></a><a href="/eco-friendly-workspace-design/"><strong>Responsible workplace design</strong><span>Considered materials and planning choices for healthier, enduring work environments.</span><b>Explore responsible design →</b></a></section>
<section class="section home-about"><div class="container home-split"><div><p class="eyebrow">About Orange Offices</p><h2>Workplace decisions grounded in how your business operates</h2><p>As part of AIHP, we combine workplace experience with interior design and coordinated delivery. We plan each office around your people, brand, workflow and future needs.</p><a class="text-link" href="/about/">Meet Orange Offices ↗</a></div><img src="/wp-content/uploads/2024/12/DSC01122.webp" alt="A warm office lounge with collaborative seating" width="1603" height="2000" loading="lazy" /></div></section>
<section class="section home-trusted"><div class="container"><p class="eyebrow">Selected client network</p><h2>Trusted by teams across the AIHP and Orange Offices network</h2><div class="client-logo-grid">{logos.map((src) => <div class="client-logo"><img src={src} alt="" width="300" height="182" loading="lazy" /></div>)}</div><a class="text-link" href="/clients/">See client stories ↗</a></div></section>
<section class="home-sustainability" style="--sustainability:url('/wp-content/uploads/2025/01/jpeg-optimizer_DSC01630.webp')"><div class="container"><p class="eyebrow">Responsible design</p><h2>Healthier materials and adaptable planning for workplaces built to last</h2><a class="button" href="/eco-friendly-workspace-design/">Explore our approach</a></div></section>
<section class="home-stats" aria-label="AIHP and Orange Offices experience"><div class="container">{[['600+','Clients across the network'],['40L+','Sq. ft. fitted out'],['99%','On-time delivery'],['12+','Years of experience']].map(([n,l]) => <div><strong>{n}</strong><span>{l}</span></div>)}</div></section>
<section class="section section--dark home-services"><div class="container"><p class="eyebrow">What we offer</p><h2>Four ways to shape a better workplace</h2><div class="home-services__grid">{services.map(([title,href,description],i) => <a href={href}><img src={serviceImages[i]} alt="" width="900" height="700" loading="lazy" /><span>0{i+1}</span><h3>{title}</h3><p>{description}</p></a>)}</div></div></section>
<section class="section home-expertise"><div class="container home-split"><div><p class="eyebrow">Our expertise</p><h2>One team from workplace brief to handover</h2><p>We turn business requirements into clear workplace decisions, visualise the proposal before work begins, and coordinate the finished interior.</p><div class="capability-list"><article><strong>Workplace strategy</strong><span>Planning around people, workflow and growth.</span></article><article><strong>Interior design</strong><span>Material, lighting and spatial decisions with a clear purpose.</span></article><article><strong>Project delivery</strong><span>Coordinated execution with clarity around the approved design.</span></article></div><a class="text-link" href="/services/">Explore our services ↗</a></div><img src="/wp-content/uploads/2025/01/jpeg-optimizer_DSC01630.webp" alt="A completed Orange Offices workspace with collaborative seating" width="2000" height="1333" loading="lazy" /></div></section>
<section class="section section--muted home-process"><div class="container"><p class="eyebrow">Our process</p><h2>A clear path from workplace brief to handover</h2><div>{process.map((title,i) => <article><span>Step 0{i+1}</span><h3>{title}</h3></article>)}</div></div></section>
<section class="section home-projects"><div class="container"><p class="eyebrow">Featured Projects</p><h2>Crafting Office Designs That Inspire Productivity</h2><div>{projects.map(([title,href,image],i) => <a href={href}><img src={image} alt={`${title} office design`} width="1000" height="700" loading="lazy" /><span>{i+1}. {title}</span></a>)}</div><a class="projects-cta" href="/collections/"><span>View all projects</span><b aria-hidden="true">→</b></a></div></section>
<section class="section section--dark home-testimonials"><div class="container"><p class="eyebrow">Testimonials</p><h2>What clients say about working with us</h2><div>{testimonials.map(([quote,name,role,logo]) => <blockquote><p>“{quote}”</p><footer><img src={logo} alt="" width="120" height="70" loading="lazy" /><cite>{name}<span>{role}</span></cite></footer></blockquote>)}</div><a class="text-link home-testimonials__link" href="/clients/">Read more client stories ↗</a></div></section>
<section class="section home-gallery"><div class="container"><p class="eyebrow">Workplace gallery</p><h2>Look closer at the spaces we have delivered</h2><p>Browse selected rooms, material details and workplace moments, then open the full case study behind each project.</p><a class="text-link" href="/gallery/">Explore the gallery →</a><div>{gallery.map((file, index) => <img src={`/wp-content/uploads/elementor/thumbs/${file}`} alt={`Completed Orange Offices workplace view ${index + 1}`} width="700" height="700" loading="lazy" />)}</div></div></section>
<section class="section page-cta"><div class="container"><p class="eyebrow">Start your project</p><h2>Planning a new office or renovation?</h2><p>Tell us about your location, team and timeline.</p><a class="button" href="/contact/">Book a free consultation</a></div></section>
