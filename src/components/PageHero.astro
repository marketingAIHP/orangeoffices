---
interface Props { eyebrow: string; title: string; description?: string; image?: string | null; meta?: string; article?: boolean; }
const { eyebrow, title, description, image, meta, article = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero--image': image, 'page-hero--article': article }]} style={image ? `--hero-image: url('${image}')` : undefined}>
  <div class="container page-hero__grid">
    <div class="page-hero__content">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {description && <p class="page-hero__description">{description}</p>}
      {meta && <p class="article-meta">{meta}</p>}
    </div>
  </div>
</section>
