---
import projectMedia from '../data/project-media.json';
const labels: Record<string, string> = { advatix: 'Advatix', 'anand-rathi-wealth': 'Anand Rathi Wealth', arcelor: 'ArcelorMittal', 'ht-media': 'HT Media', indxx: 'INDXX', mozaiq: 'MOZAIQ', wishlink: 'Wishlink' };
const items = Object.entries(projectMedia).flatMap(([slug, images]) => images.filter((image) => !image.isDetailCrop).slice(0, 2).map((image) => ({ ...image, slug, project: labels[slug] || slug.replaceAll('-', ' ') }))).slice(0, 18);
---
<section class="gallery-hero"><div class="container"><p class="eyebrow">Workplace gallery</p><h1>Details that make a workplace work</h1><p>Explore completed spaces, materials and moments from selected Orange Offices projects.</p></div></section>
<section class="section gallery-index"><div class="container"><div class="gallery-index__grid">{items.map((item) => <figure><a href={`/project/${item.slug}/`}><img src={item.src} alt={item.alt || `${item.project} workplace`} width="1000" height="750" loading="lazy" /><figcaption><strong>{item.project}</strong><span>View case study →</span></figcaption></a></figure>)}</div></div></section>
<section class="section page-cta"><div class="container"><p class="eyebrow">Start your project</p><h2>Planning a new office or renovation?</h2><p>Tell us about your space, team and timeline.</p><a class="button" href="/contact/">Book a free consultation <span aria-hidden="true">→</span></a></div></section>
