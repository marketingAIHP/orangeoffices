---
import { parseProjectDetail, type ProjectRecord } from '../lib/projects';
interface Project extends ProjectRecord { title: string; path: string; image?: string }
const { projects } = Astro.props as { projects: Project[] };
const projectCards = projects.map((project) => ({ project, detail: parseProjectDetail(project, projects) }));
---
<section class="collections-hero"><div class="container collections-hero__content"><p class="eyebrow">Selected projects</p><h1>Workplaces shaped around people and purpose</h1><p>Explore completed offices for teams across finance, healthcare, media, technology and growing businesses.</p></div></section>
<section class="section collections-projects"><div class="container"><div class="collections-projects__heading"><p class="eyebrow">Project portfolio</p><h2>Explore our completed workplaces</h2><p>Open a case study to see the brief, approach and finished space.</p></div><div class="collections-projects__grid">{projectCards.map(({ project, detail }) => <article class="collection-card"><a href={project.path}>{project.image && <img src={project.image} alt={`${project.title} workplace project`} width="1000" height="680" loading="lazy" />}<div class="collection-card__body"><h3>{project.title}</h3>{detail.metadata.length > 0 && <p>{detail.metadata.slice(0, 2).map((item) => item.value).join(' · ')}</p>}<span>View case study <b aria-hidden="true">↗</b></span></div></a></article>)}</div></div></section>
<section class="section collections-intro"><div class="container collections-intro__grid"><img src="/wp-content/uploads/2025/01/Wishlink-4.webp" alt="A collaborative workplace designed by Orange Offices" width="2000" height="1410" loading="lazy" /><div><p class="eyebrow">Our approach</p><h2>From brief to finished workplace</h2><p>We combine workplace strategy, interior design and dependable delivery to shape offices around how each business operates.</p><ul><li><strong>Bespoke interiors</strong> aligned with brand and team needs.</li><li><strong>Flexible planning</strong> that supports collaboration and growth.</li><li><strong>Responsible material choices</strong> for healthier, enduring spaces.</li><li><strong>Renovation and fit-out</strong> coordinated through a clear process.</li></ul></div></div></section>
<section class="section page-cta collections-cta"><div class="container"><p class="eyebrow">Start your project</p><h2>Let’s bring your dream office to life</h2><p>Ready to transform your workspace? Partner with Orange Offices for a tailor-made office interior design experience that prioritizes your vision and business goals.</p><a class="button" href="/contact/">Contact our design team <span aria-hidden="true">→</span></a></div></section>
