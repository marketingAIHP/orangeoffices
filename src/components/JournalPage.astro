const principles = [
  ['Natural Materials', 'At Orange Offices, we believe in the beauty and authenticity of natural materials. From rich woods to stone textures, these elements ground workspaces in nature, creating environments that feel warm, organic and timeless. Using sustainable materials not only enhances the aesthetic appeal of the office but also promotes a deeper connection between people and the spaces they inhabit.', '/wp-content/uploads/2025/01/Natural-material.webp'],
  ['Sustainability', 'Sustainability is at the core of our design philosophy. We are committed to using eco-friendly materials and energy-efficient solutions in every project. By prioritizing green design, we ensure that our spaces support both the environment and the well-being of those who work in them. This approach reflects our responsibility to create workplaces that are as mindful of the planet as they are of the people who use them.', '/wp-content/uploads/2025/01/jpeg-optimizer_DSC07567-1.webp'],
  ['Less Is More', 'We embrace minimalism in design because it allows the essence of a space to shine. By reducing clutter and focusing on the essentials, we create work environments that foster clarity and calm. A clean, simple design enables creativity to flow without distractions, providing employees with the mental space they need to innovate and thrive.', '/wp-content/uploads/2025/01/jpeg-optimizer_DSC08191.webp'],
  ['Pops of Personality', 'Every workspace has a unique story to tell. With carefully selected art, vibrant colors and statement pieces, we inject personality into every design. These touches make the space feel alive, dynamic and reflective of the company’s identity. It’s the little details that transform a functional space into an inspiring one.', '/wp-content/uploads/2025/01/Wishlink-4.webp'],
  ['Light as Design', 'Lighting is more than just a tool; it’s a key design element that shapes the mood and functionality of a workspace. At Orange Offices, we use both natural and artificial lighting to create a harmonious atmosphere. Whether it’s the soft glow of natural light streaming through windows or strategically placed fixtures, light enhances the aesthetic and performance of a space.', '/wp-content/uploads/2025/01/DSC07207-scaled-1.jpg'],
  ['Harmony in Contrast', 'At Orange Offices, we believe in the power of contrast to bring a design to life. By blending different textures, colors and materials, we create spaces that are visually engaging and full of energy. The juxtaposition of soft and bold, dark and light, modern and traditional creates a sense of balance that elevates the overall design, making it both dynamic and cohesive.', '/wp-content/uploads/2025/01/Harmony-in-Contrast.webp'],
];
