---
const {node} = Astro.props
const rows = node?.rows ?? []
---
<div class="table-scroll"><table>{node?.caption && <caption>{node.caption}</caption>}<tbody>{rows.map((row: {cells?: string[]}, rowIndex: number) => <tr>{(row.cells ?? []).map((cell, cellIndex) => rowIndex === 0 ? <th scope="col">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>
