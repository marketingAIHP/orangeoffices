{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orangeoffices",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page" },
  "observability": { "enabled": true }
}
