{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orange-offices-web",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page" },
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "LEADS_DB", "database_name": "orange-offices-leads", "database_id": "REPLACE_WITH_CLOUDFLARE_D1_ID", "migrations_dir": "migrations/d1" }],
  "r2_buckets": [{ "binding": "LEGACY_MEDIA", "bucket_name": "orange-offices-legacy-media" }],
  "queues": { "producers": [{ "binding": "LEAD_QUEUE", "queue": "orange-offices-leads" }] }
}
